POSTGRES_DB=hostly
POSTGRES_USER=hostly
POSTGRES_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-at-least-32-random-characters
APP_PORT=1591
STATIC_PORT=1592
APP_ORIGIN=http://0.0.0.0:1591
PROJECTS_ORIGIN=http://0.0.0.0:1592
MAX_UPLOAD_MB=100

# Runner de aplicações PHP/Node
RUNNER_PORT=1593
RUNNER_CONTROL_PORT=1594
RUNNER_TOKEN=replace-with-a-long-random-secret
# Domínio base para os subdomínios de todos os projetos (estático, PHP/Node e Docker)
# (ex.: sites.seudominio.com). Sem ele, os sites estáticos ficam em /slug/.
PROJECTS_DOMAIN=
PROJECTS_SCHEME=https
PORT_BASE=21000
RUNNER_NODE_MEM_MB=256
RUNNER_PHP_MEMORY=256M

# Conta(s) administradoras (separadas por vírgula). Recebem acesso à página de
# manutenção do Docker (limpeza, prune). O e-mail precisa ser o mesmo do cadastro.
ADMIN_EMAILS=

# Chave para criptografar os tokens do GitHub no banco. Use um valor aleatório forte.
ENCRYPTION_SECRET=replace-with-a-long-random-secret

# Banco de dados por projeto
# Cada projeto pode ter um banco próprio dentro da MESMA instância do Postgres
# (serviço "db"). Não são criados contêineres nem imagens extras.
# Host/porta do Postgres vistos de dentro da rede do docker-compose.
PROJECT_DB_HOST=db
PROJECT_DB_PORT=5432
# Tamanho (MB) a partir do qual o painel avisa que o banco passou do limite
# sugerido. É apenas um aviso: nada é bloqueado.
PROJECT_DB_ALERT_MB=200
# Porta do Postgres publicada no host, presa ao 127.0.0.1 (acesso local).
# Acesso remoto: use túnel SSH ou "cloudflared access tcp".
DB_HOST_PORT=55432
# Host público do Postgres, ex.: db.seudominio.com. Exige uma rota
# "tcp://" no Cloudflare Tunnel para esse hostname. Vazio = a URL externa
# usa o 127.0.0.1 (acesso no próprio servidor).
PROJECT_DB_PUBLIC_HOST=
PROJECT_DB_PUBLIC_PORT=5432
# Tamanho máximo (MB) de um arquivo aberto no editor do painel
MAX_EDIT_BYTES=2
# Rede (Docker) onde o Postgres é publicado para os contêineres dos projetos
DATABASES_NETWORK=hostfy_databases

# Manutenção automática do Docker
CLEANUP_ENABLED=true
# Carência antes de remover contêineres parados / imagens e volumes sem uso (horas)
CLEANUP_GRACE_HOURS=24
# Intervalo entre varreduras de limpeza (minutos)
CLEANUP_INTERVAL_MINUTES=60
# Tempo máximo para operações do Docker (ms), incluindo builds de Compose
DOCKER_TIMEOUT_MS=1200000
