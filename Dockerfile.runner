# Imagem do runner de aplicações (PHP + Node).
# Executa os processos dos projetos e faz o proxy por subdomínio.
FROM node:22-alpine
WORKDIR /app

COPY package*.json ./
RUN npm install --omit=dev && npm cache clean --force
COPY src ./src

# PHP CLI com as extensões mais comuns. Tenta os nomes versionados (php83) e,
# se a base usar nomes sem versão, cai no conjunto genérico.
RUN apk add --no-cache \
      php83 php83-cli php83-fpm php83-mbstring php83-curl php83-openssl \
      php83-pdo php83-pdo_mysql php83-pdo_pgsql php83-sqlite3 php83-dom \
      php83-session php83-tokenizer php83-fileinfo php83-xml php83-json \
      php83-zip php83-gd \
    || apk add --no-cache \
      php php-cli php-fpm php-mbstring php-curl php-openssl \
      php-pdo php-pdo_mysql php-pdo_pgsql php-sqlite3 php-dom \
      php-session php-tokenizer php-fileinfo php-xml php-json \
      php-zip php-gd

# CLI do Docker + plugin do Compose v2 para gerenciar os projetos Compose.
# O socket do Docker é montado pelo docker-compose.yml.
RUN apk add --no-cache docker-cli docker-cli-compose

RUN mkdir -p /data/projects /tmp/hostly && chown -R node:node /data/projects /tmp/hostly /app

# Garante o binário "php" mesmo quando o Alpine só instala "php83".
RUN command -v php >/dev/null 2>&1 || ln -sf "$(command -v php83)" /usr/local/bin/php

USER node
EXPOSE 1593 1594
CMD ["node", "src/runner.js"]